{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "panels": [
    {
      "title": "System Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Total HTTP Requests/sec",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (app_name)",
          "legendFormat": "{{app_name}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 }
    },
    {
      "title": "Error Rate (HTTP 5xx)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m]))",
          "legendFormat": "Error Rate"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }
    },
    {
      "title": "RabbitMQ / Training Worker",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "title": "Training Messages Processed",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(training_messages_processed_total)",
          "legendFormat": "Processed"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 }
    },
    {
      "title": "Training Messages Retried",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(training_messages_retried_total)",
          "legendFormat": "Retried"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 10 }
    },
    {
      "title": "Training Messages Failed (DLQ)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(training_messages_failed_total)",
          "legendFormat": "Failed"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 10 }
    }
  ],
  "schemaVersion": 30,
  "style": "dark",
  "tags": [],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MLForge System Overview",
  "uid": "mlforge-main",
  "version": 1
}
