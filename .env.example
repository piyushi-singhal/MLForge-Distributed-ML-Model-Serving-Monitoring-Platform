# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlforge
POSTGRES_USER=mlforge
POSTGRES_PASSWORD=mlforge_dev_pwd

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Authentication Config
JWT_SECRET=super_secret_dev_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Internal Microservice Routing (Docker Compose Network)
AUTH_SERVICE_URL=http://auth-service:8000
MODEL_SERVICE_URL=http://model-service:8000
TRAINING_SERVICE_URL=http://training-service:8000
PREDICTION_SERVICE_URL=http://prediction-service:8000
